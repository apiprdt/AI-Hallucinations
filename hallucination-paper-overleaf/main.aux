\newlabel{tab:calibration}{{2}{17}{Calibration metrics (Brier Score and Expected Calibration Error) for selected conditions on BBBP and BACE. Higher values indicate worse calibration. The substantial increase under C3 on BACE quantifies the observed distributional compression effect; C4a largely preserves or improves baseline calibration on both tasks}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Hallucination augmentation induces pronounced distributional compression on the BACE task, shifting the baseline bimodal prediction distribution toward a non-discriminative narrow peak near $p \approx 0.17$.}}{17}{figure.4}\protected@file@percent }
